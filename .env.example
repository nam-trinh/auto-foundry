OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_MODEL_DEV=gpt-5-mini
LLM_MODEL_PROD=gpt-5
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1200
AUTO_FOUNDRY_DB_PATH=auto_foundry.sqlite3

# Source ingestion
INGESTION_SOURCE=mock
INGESTION_SOURCES=mock
INGESTION_LIMIT=25

# Reddit via PRAW. Required only when INGESTION_SOURCE=reddit or when using RedditAdapter directly.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=auto-foundry-local/0.1
REDDIT_SUBREDDITS=startups,SaaS,Entrepreneur
REDDIT_LISTING_MODE=hot
REDDIT_INCLUDE_COMMENTS=false
REDDIT_COMMENT_LIMIT=25

# Hacker News official Firebase API.
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
HN_LISTING=askstories
HN_INCLUDE_COMMENTS=false
HN_COMMENT_LIMIT=25

# Stack Exchange API.
STACK_EXCHANGE_SITE=stackoverflow
STACK_EXCHANGE_TAGS=python;fastapi
STACK_EXCHANGE_SORT=activity
STACK_EXCHANGE_ORDER=desc
STACK_EXCHANGE_KEY=

# GitHub REST API. Token is optional for public repos but improves rate limits.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_STATE=open
GITHUB_INCLUDE_COMMENTS=false
GITHUB_COMMENT_LIMIT=25
